    rgbled_7.setColor(0,0,0,0);
    rgbled_7.show();
    mode = 1;

  }
  while(1) {
      if(ultrasonic_3.distanceCm() < 10){
        motor_9.run(0);
        motor_10.run(0);

      }else{
        if(mode == 1.000000){
          if(linefollower_2.readSensors() == 0.000000){

            move(1, 80 / 100.0 * 255);

          }
          if(linefollower_2.readSensors() == 1.000000){

            motor_9.run(-1*0/100.0*255);

            motor_10.run(1*90/100.0*255);

          }
          if(linefollower_2.readSensors() == 2.000000){

            motor_9.run(-1*90/100.0*255);

            motor_10.run(1*0/100.0*255);

          }
          if(linefollower_2.readSensors() == 3.000000){

            move(2, 50 / 100.0 * 255);

          }

        }else{
          if(mode == 2.000000){
            if(linefollower_2.readSensors() == 3.000000){

              move(1, 80 / 100.0 * 255);

            }
            if(linefollower_2.readSensors() == 2.000000){

              motor_9.run(-1*0/100.0*255);

              motor_10.run(1*90/100.0*255);

            }
            if(linefollower_2.readSensors() == 1.000000){

              motor_9.run(-1*90/100.0*255);

              motor_10.run(1*0/100.0*255);

            }
            if(linefollower_2.readSensors() == 0.000000){

              move(2, 50 / 100.0 * 255);

            }

          }

        }

      }

      _loop();
  }

}

