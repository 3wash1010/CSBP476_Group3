    rgbled_7.setColor(0,194,248,251);
    rgbled_7.show();
    _delay(1);
    rgbled_7.setColor(0,0,0,0);
    rgbled_7.show();

    buzzer.tone(4699, 0.5 * 1000);
    _delay(0.02);
    mode = 2;

  }else{

    buzzer.tone(65, 0.5 * 1000);
    _delay(0.02);

    rgbled_7.setColor(0,14,0,21);
    rgbled_7.show();
